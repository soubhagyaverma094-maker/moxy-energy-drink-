  var num=e.target.querySelector&&e.target.querySelector('.num[data-count]');if(num)animateCount(num);io.unobserve(e.target);}});},{threshold:.15});
document.querySelectorAll('.reveal').forEach(function(el,i){el.style.transitionDelay=(i%4)*0.06+'s';io.observe(el);});
function animateCount(el){var target=+el.getAttribute('data-count');var suf=el.getAttribute('data-suffix')||'';var dur=1300,start=performance.now();
  function step(t){var p=Math.min((t-start)/dur,1);var ease=1-Math.pow(1-p,3);el.textContent=Math.round(ease*target)+suf;if(p<1)requestAnimationFrame(step);}
  requestAnimationFrame(step);}

