/* NAV */
var hdr=document.getElementById('hdr');
addEventListener('scroll',function(){hdr.classList.toggle('scrolled',scrollY>40);
  document.getElementById('toTop').classList.toggle('show',scrollY>600);},{passive:true});
function scrollToId(id){var el=document.getElementById(id);if(el)el.scrollIntoView({behavior:'smooth'});closeMenu();}
function toggleMenu(){document.getElementById('mobileMenu').classList.toggle('open');}
function closeMenu(){document.getElementById('mobileMenu').classList.remove('open');}

/* HERO SCROLL SCRUB (cover-fit fullscreen) */
var canvas=document.getElementById('heroCanvas');
var ctx=canvas.getContext('2d');
var images=[];var total=HERO_FRAMES.length;
var heroEl=document.getElementById('hero');
var heroCopy=document.getElementById('heroCopy');
var scrollHint=document.getElementById('scrollHint');
var curFrame=-1,natW=480,natH=853;

HERO_FRAMES.forEach(function(src,i){var im=new Image();im.onload=function(){if(i===0){natW=im.naturalWidth;natH=im.naturalHeight;sizeCanvas();draw(0);}};im.src=src;images[i]=im;});

function sizeCanvas(){
  var dpr=Math.min(devicePixelRatio||1,2);
  canvas.width=innerWidth*dpr;canvas.height=innerHeight*dpr;
  canvas.style.width=innerWidth+'px';canvas.style.height=innerHeight+'px';
  ctx.setTransform(dpr,0,0,dpr,0,0);
}
function draw(f){
  var im=images[f];if(!im||!im.complete)return;
  var cw=innerWidth,ch=innerHeight;
  ctx.clearRect(0,0,cw,ch);
  // 1) blurred COVER layer fills the whole screen (no empty bars)
  var cs=Math.max(cw/natW,ch/natH);
  var cwd=natW*cs,chd=natH*cs;
  ctx.save();
  ctx.filter='blur(24px) brightness(.55)';
  ctx.drawImage(im,(cw-cwd)/2,(ch-chd)/2,cwd,chd);
  ctx.restore();
  // 2) sharp CONTAIN layer shows the FULL bottle (cap never cropped)
  var pad=ch>cw?0.98:0.92; // leave a little breathing room
  var ks=Math.min(cw/natW,ch/natH)*pad;
  var w=natW*ks,h=natH*ks;
  ctx.drawImage(im,(cw-w)/2,(ch-h)/2,w,h);
}
function onScrollHero(){
  var rect=heroEl.getBoundingClientRect();
  var scrollable=heroEl.offsetHeight-innerHeight;
  var progress=Math.min(Math.max(-rect.top/scrollable,0),1);
  var f=Math.min(total-1,Math.floor(progress*(total-1)));
  if(f!==curFrame){curFrame=f;draw(f);}
  heroCopy.classList.toggle('show',progress>0.72);
  scrollHint.style.opacity=progress>0.06?'0':'1';
}
addEventListener('scroll',onScrollHero,{passive:true});
addEventListener('resize',function(){sizeCanvas();draw(curFrame<0?0:curFrame);});

/* REVEAL + counters */
