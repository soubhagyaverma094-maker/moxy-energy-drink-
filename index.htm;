/* 3D BACKGROUND: rising energy bubbles + spark particles */
(function(){
  var c=document.getElementById('bg3d');var g=c.getContext('2d');
  var W,H,DPR;var N=window.innerWidth<700?26:44;var parts=[];
  var pal=['#C6FF3D','#FF2E93','#22E0FF','#FF8A00'];
  function resize(){DPR=Math.min(devicePixelRatio||1,2);W=c.width=innerWidth*DPR;H=c.height=innerHeight*DPR;c.style.width=innerWidth+'px';c.style.height=innerHeight+'px';}
  resize();addEventListener('resize',resize);
  function rnd(a,b){return a+Math.random()*(b-a);}
  for(var i=0;i<N;i++){var bubble=Math.random()>0.4;
    parts.push({x:Math.random()*W,y:Math.random()*H,z:rnd(.3,1),
      r:bubble?rnd(4,14):rnd(1,2.5),vy:rnd(-.3,-.9),vx:rnd(-.15,.15),
      col:pal[i%pal.length],op:bubble?rnd(.06,.2):rnd(.2,.5),bubble:bubble,ph:rnd(0,6.28)});}
  var mx=0,my=0;addEventListener('pointermove',function(e){mx=(e.clientX/innerWidth-.5)*2;my=(e.clientY/innerHeight-.5)*2;});
  function loop(){g.clearRect(0,0,W,H);
    for(var k=0;k<parts.length;k++){var p=parts[k];
      p.y+=p.vy*p.z*DPR;p.x+=p.vx*p.z*DPR+Math.sin(p.ph)*0.3;p.ph+=0.03;
      if(p.y<-30)p.y=H+30,p.x=Math.random()*W;
      var dx=mx*30*p.z*DPR,dy=my*30*p.z*DPR;
      var rr=p.r*p.z*DPR;var gx=p.x+dx,gy=p.y+dy;
      g.globalAlpha=p.op;
      if(p.bubble){g.strokeStyle=p.col;g.lineWidth=1.4*DPR;g.beginPath();g.arc(gx,gy,rr,0,6.2832);g.stroke();
        g.globalAlpha=p.op*.4;g.fillStyle=p.col;g.beginPath();g.arc(gx-rr*.3,gy-rr*.3,rr*.35,0,6.2832);g.fill();}
      else{g.fillStyle=p.col;g.shadowBlur=6*DPR;g.shadowColor=p.col;g.beginPath();g.arc(gx,gy,rr,0,6.2832);g.fill();g.shadowBlur=0;}
    }
